{
  "name": "playwright-ai",
  "version": "1.0.0",
  "description": "Test Automation Framework built with Playwright and use of AI",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "codegen": "npx playwright codegen",
    "test:report": "npx playwright show-report",
    "install:browsers": "npx playwright install",
    "heal": "tsx scripts/heal.ts",
    "lint": "npx eslint",
    "lint:fix": "npx eslint --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "tests/**/*.ts": "eslint --fix",
    "src/**/*.ts": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marciniak-michal/playwright-ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/marciniak-michal/playwright-ai/issues"
  },
  "homepage": "https://github.com/marciniak-michal/playwright-ai#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-plugin-playwright": "^2.10.4",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.7",
    "openai": "^6.38.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.3"
  }
}
